{
  "name": "@lordekeen/pi-chafa",
  "version": "0.2.1",
  "description": "Show image files to the user in the pi terminal — native kitty/iTerm2 where supported, Chafa ANSI symbols everywhere else.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "chafa",
    "terminal-image",
    "kitty-graphics",
    "iterm2",
    "ansi-art"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordekeen/pi-chafa.git"
  },
  "homepage": "https://github.com/lordekeen/pi-chafa#readme",
  "bugs": "https://github.com/lordekeen/pi-chafa/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src/",
    "skills/",
    "assets/",
    "pi-chafa.example.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/lordekeen/pi-chafa/main/assets/pi-chafa.png"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@earendil-works/pi-tui": "^1.0.4",
    "@types/node": "^20.0.0",
    "typebox": "^1.3.7",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
